# ─────────────────────────────────────────────────────────────────────────────
# Banco de dados
#
# O provider do Prisma segue esta string de conexão automaticamente
# (scripts/db-provider.mjs, executado no build). Não é preciso editar o schema.
#
# Desenvolvimento — SQLite, sem serviço externo:
DATABASE_URL="file:./dev.db"
#
# Produção — PostgreSQL. Na Vercel, use a string COM POOL (pgbouncer):
# funções serverless abrem muitas conexões e um Postgres sem pool esgota o
# limite rapidamente.
# DATABASE_URL="postgresql://user:senha@host/banco?sslmode=require&pgbouncer=true&connection_limit=1"
# ─────────────────────────────────────────────────────────────────────────────

# Assinatura dos cookies de sessão. Gere um valor próprio para cada ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar este valor invalida todas as sessões abertas.
AUTH_SECRET="dev-secret-change-me-in-production-please-use-32-bytes-min"

# Endereço público da aplicação.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
